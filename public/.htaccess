ErrorDocument 404 /404.html

# Cache policy. Added 2026-09-24 after repeated "I'm still seeing the old
# version" reports: the site previously sent no Cache-Control header at all,
# only Last-Modified/ETag. With no explicit directive browsers fall back to
# heuristic caching and can serve a stale copy for a long time without ever
# revalidating, which is why edits looked live on a fresh fetch but stale in
# a browser that had visited before.
<IfModule mod_headers.c>
  # HTML must always revalidate. It is small, and it is what points at every
  # hashed asset below, so a stale copy is what makes everything else stale.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite fingerprints these with a content hash, so the filename changes
  # whenever the bytes do. They can safely be cached hard and forever.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2|png|jpe?g|webp|gif|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
